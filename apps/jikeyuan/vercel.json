{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/guides/hong-kong-entry-timeline",
      "destination": "/guides/hong-kong-entry-timeline/index.html"
    },
    {
      "source": "/guides/hong-kong-rental-checklist",
      "destination": "/guides/hong-kong-rental-checklist/index.html"
    },
    {
      "source": "/guides/octopus-mtr-bus-guide",
      "destination": "/guides/octopus-mtr-bus-guide/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/guides",
      "destination": "/index.html"
    },
    {
      "source": "/guides/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/questions/new",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/register",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/community",
      "has": [{ "type": "query", "key": "state" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
