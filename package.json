{
  "name": "react-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@react-monorepo/web",
    "dev:admin": "npm run dev --workspace=@react-monorepo/admin",
    "dev:jikeyuan": "npm run dev --workspace=@react-monorepo/jikeyuan",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.4.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.0",
    "@astryxdesign/theme-neutral": "^0.4.0",
    "@stylexjs/stylex": "^0.19.0",
    "react-router-dom": "^7.18.2"
  }
}
